# Django
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=*

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

# LLM
LLM_MODEL=poolside/laguna-s-2.1:free
LLM_FALLBACK_MODELS=openai/gpt-oss-20b:free,nvidia/nemotron-nano-9b-v2:free

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# Chroma (web connects to the chroma service)
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=roshan_documents

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4
RETRIEVAL_FETCH_K=20
RETRIEVAL_MAX_DOCS=3

# API rate limiting (DRF throttling)
# THROTTLE_USER_RATE=300/minute
# THROTTLE_ANON_RATE=30/minute
# THROTTLE_DEMO_RATE=10/minute
# THROTTLE_DEMO_POLL_RATE=240/minute

# Superuser created automatically on startup
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
# Disable the experimental Hugging Face xet backend which can hang on some networks
HF_HUB_DISABLE_XET=1

# Paths are set by docker-compose (SQLITE_PATH=/app/data/db.sqlite3, MEDIA_ROOT=/app/media)

# Production: set DEBUG=false and a strong SECRET_KEY. The default SECRET_KEY
# and DEBUG=true are only safe for local development.
# SECRET_KEY=change-me-to-a-long-random-string
# DEBUG=false
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Optional: HF_TOKEN speeds up Hugging Face model downloads (and removes the warning)
