# Django
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=*

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

# LLM
LLM_MODEL=poolside/laguna-s-2.1:free
LLM_FALLBACK_MODELS=deepseek/deepseek-chat:free,qwen/qwen-2.5-72b-instruct:free

# Embeddings
EMBEDDING_MODEL=jinaai/jina-embeddings-v3

# Chroma (web connects to the chroma service)
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=roshan_documents

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DOCS=3

# Superuser created automatically on startup
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# Paths
SQLITE_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/media